# ───────────── Drowify Music — contoh environment ─────────────
# Salin menjadi .env (lokal) atau isi di Vercel → Project → Settings → Environment Variables.
# JANGAN commit file .env. Tidak ada secret yang boleh berada di frontend (semua di bawah ini dibaca server).

# ── Login Google (wajib untuk akun) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized JavaScript origins: https://domainmu.vercel.app dan http://localhost:5173
GOOGLE_CLIENT_ID=
# Rahasia penanda tangan sesi (minimal 32 karakter acak). Buat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ── Penyimpanan data akun (wajib agar login/sinkron bekerja di Vercel) ──
# Upstash Redis (gratis) via Vercel Marketplace → otomatis mengisi salah satu pasangan di bawah:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (atau nama bawaan integrasi lama)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Foto profil kustom (opsional tetapi disarankan) ──
# Vercel Blob. Tanpa ini, foto disimpan sebagai objek kecil (<=64 KB) di Redis.
BLOB_READ_WRITE_TOKEN=

# ── Import playlist Spotify (opsional) ──
# Hanya CLIENT ID (publik, PKCE). Client Secret TIDAK diperlukan dan tidak boleh dipakai di frontend.
# Redirect URI yang didaftarkan di Spotify Dashboard: https://domainmu.vercel.app/spotify/callback
# (lokal: http://127.0.0.1:5173/spotify/callback)
SPOTIFY_CLIENT_ID=

# ── Aturan Drowify Streak (semua opsional) ──
STREAK_MIN_PLAYS_PER_DAY=1       # jumlah pemutaran valid per hari agar hari dihitung aktif
STREAK_MIN_MINUTES_PER_DAY=0     # tambahan syarat menit dengar valid per hari (0 = tidak dipakai)
STREAK_RECOVERY_DAYS=7           # lama masa pemulihan sejak hari pertama terlewat

# ── Situs (untuk meta OG/robots/sitemap saat build) ──
SITE_URL=

# ── Pengembangan lokal ──
# PORT=3000
# DEV_DB_FILE=.data/db.json      # lokal otomatis memakai file ini bila Upstash tidak diisi
